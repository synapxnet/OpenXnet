{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openxnet.synapxnet.com/skills/goai-change-execute/1.1.0/input.schema.json",
  "title": "GOAI Change Execute Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "incidentId", "traceId", "evidence", "proposedPlan", "approvalRequired"],
  "properties": {
    "schema": { "const": "goai.skill.change-execute.input.v1.1" },
    "incidentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "traceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "toolName", "contentDigest"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "toolName": { "type": "string", "minLength": 1, "maxLength": 160 },
          "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "proposedPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "planDigest", "steps", "compensationSteps"],
      "properties": {
        "planId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "planDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/planStep" }
        },
        "compensationSteps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/planStep" }
        }
      }
    },
    "approvalRequired": { "const": true }
  },
  "$defs": {
    "planStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "toolName", "resourceId", "targetRevision", "expectedResourceVersion", "argumentsDigest", "dependsOn"],
      "properties": {
        "stepId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "toolName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,7}$" },
        "resourceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "targetRevision": { "type": "integer", "minimum": 1 },
        "expectedResourceVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "argumentsDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dependsOn": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  }
}
