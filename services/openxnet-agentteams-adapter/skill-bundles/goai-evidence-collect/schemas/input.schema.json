{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openxnet.synapxnet.com/skills/goai-evidence-collect/1.1.0/input.schema.json",
  "title": "GOAI Evidence Collect Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "incidentId", "traceId", "availableTools", "requiredPlatforms", "approvalRequiredTools"],
  "properties": {
    "schema": { "const": "goai.skill.evidence-collect.input.v1.1" },
    "incidentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "traceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "availableTools": {
      "type": "array",
      "minItems": 3,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,7}$" }
    },
    "requiredPlatforms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["aiops", "dataops", "mlops"] }
    },
    "approvalRequiredTools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,7}$" }
    }
  }
}
