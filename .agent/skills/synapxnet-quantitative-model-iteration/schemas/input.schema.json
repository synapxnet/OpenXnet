{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openxnet.synapxnet.com/skills/synapxnet-quantitative-model-iteration/1.1.0/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workspaceId", "incidentId", "traceId", "scenarioType", "environmentScope", "evidenceIds", "expectedResourceVersion", "approvalId", "planDigest", "approvedStepIds", "compensationStepIds", "allowedTools"],
  "properties": {
    "schema": { "const": "synapxnet.skill.quantitative-iteration.input.v1" },
    "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "incidentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "traceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scenarioType": { "const": "quantitative-iteration" },
    "environmentScope": { "enum": ["simulation", "staging", "shadow", "canary", "production"] },
    "evidenceIds": { "type": "array", "minItems": 6, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "expectedResourceVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "approvalId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "planDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approvedStepIds": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "compensationStepIds": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "allowedTools": { "type": "array", "minItems": 7, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,7}$" } }
  }
}
