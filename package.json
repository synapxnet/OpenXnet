      "url": "https://download.openxnet.synapxnet.com/releases/latest/"
    },
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "build-ts/desktop/",
      "LICENSE",
      "README.md",
      "static/source/",
      "static/js/preload.js",
      "static/js/skeleton-preload.js",
      "static/js/surface-preload.js",
      "static/js/vrm-preload.js",
      "static/skeleton.html",
      "static/js/shotPreload.js",
      "static/js/webview-preload.js",
      "static/shotOverlay.html",
      "static/source/icon_tray.png"
    ],
    "extraResources": [
      {
        "from": "static/",
        "to": "ui",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vrm/",
        "to": "vrm",
        "filter": [
          "animations/**/*",
          "scene/**/*",
          "asr/**/*",
          "vrm/Eku_VRM_v1_0_0/**/*"
        ]
      },
      {
        "from": "skills/",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".agent/skills/",
        "to": "skills",
        "filter": [
          "goai-evidence-collect/**/*",
          "goai-change-execute/**/*",
          "goai-service-verify/**/*"
        ]
      },
      {
        "from": "dist/server/",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/npm/",
        "to": "npm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "icon": "static/source/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}-Linux.${ext}"
    },
    "mac": {
      "icon": "static/source/icon.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-Mac.${ext}",
      "category": "public.app-category.utilities",
      "identity": "openxnet",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "type": "distribution",
      "asarUnpack": "**/*.node",
      "extendInfo": {
        "NSRequiresAquaSystemAppearance": false
      },
      "provisioningProfile": null
    },
    "dmg": {
      "icon": "static/source/icon.icns",
      "iconSize": 100,
      "contents": [
        {
          "x": 380,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 180,
          "type": "file"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "static/source/icon.ico",
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis"
      ],
      "signtoolOptions": {
        "publisherName": "synapxnet",
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": true,
      "installerIcon": "static/source/icon.ico",
      "uninstallerIcon": "static/source/icon.ico",
      "installerHeaderIcon": "static/source/icon.ico",
      "differentialPackage": true,
      "perMachine": false,
      "displayLanguageSelector": false,
      "installerSidebar": null,
      "include": "installer/installer.nsh"
    }
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.15",
    "@types/tar-stream": "^3.1.4",
    "@vue/compiler-dom": "^3.5.22",
    "archiver": "^7.0.1",
    "cross-env": "^7.0.3",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "parse5": "^7.3.0",
    "tar-stream": "^3.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "electron-dl": "3.5.0",
    "electron-updater": "^6.8.9",
    "extract-zip": "2.0.1",
    "form-data": "^4.0.6",
    "js-yaml": "4.3.0",
    "npm": "11.19.0",
    "osc": "^2.4.5",
    "tar": "^7.5.21",
    "yauzl": "2.10.0"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "osc": {
      "ws": "8.21.1"
    }
  }
}
